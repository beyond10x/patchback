          "type": "integer"
        },
        "topology_id": {
          "$ref": "#/$defs/patchback.patch.TopologyId"
        },
        "total_loss": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "trace_id": {
          "$ref": "#/$defs/patchback.studio.TraceId"
