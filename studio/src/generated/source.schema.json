      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.PortRate"
    },
    "patchback.patch.TopologyId": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "TopologyId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.patch.TopologyId"
