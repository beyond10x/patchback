        "ports": {
          "items": {
            "$ref": "#/$defs/patchback.studio.PortSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "ports",
        "parameters"
      ],
      "title": "ModuleSpec",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "patchback.studio.ModuleSpec"
    },
