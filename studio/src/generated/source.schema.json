    "patchback.studio.GraphEdge": {
      "additionalProperties": false,
      "description": "One drawn edge, coloured by its rate. delayed_feedback marks the edge leaving the Delay node that closes a cycle (DESIGN.md section 5.4: a cycle is admitted only through a Delay node of at least one sample); the studio draws it as a return arc.",
      "properties": {
        "delayed_feedback": {
          "type": "boolean"
        },
        "from_node": {
          "type": "integer"
        },
        "from_port": {
          "$ref": "#/$defs/patchback.patch.PortName"
        },
        "rate": {
          "$ref": "#/$defs/patchback.patch.PortRate"
        },
        "to_node": {
          "type": "integer"
        },
        "to_port": {
          "$ref": "#/$defs/patchback.patch.PortName"
        }
      },
      "required": [
        "from_node",
        "from_port",
        "to_node",
        "to_port",
        "rate",
        "delayed_feedback"
      ],
      "title": "GraphEdge",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "patchback.studio.GraphEdge"
    },
    "patchback.studio.GraphNode": {
      "additionalProperties": false,
      "description": "One node of a drawn patch: the patch's node id and kind, and its rank, the longest path to it from a node with no inputs once every delayed feedback edge is removed. The studio lays nodes out left to right by rank.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/patchback.patch.NodeKind"
        },
        "node_id": {
          "minimum": 0,
          "type": "integer"
        },
        "rank": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "node_id",
        "kind",
        "rank"
      ],
      "title": "GraphNode",
      "type": "object",
      "x-ess-invariants": [
        "node_id >= 0",
        "rank >= 0"
      ],
      "x-ess-kind": "struct",
      "x-ess-name": "patchback.studio.GraphNode"
    },
    "patchback.studio.GraphViewId": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "GraphViewId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.studio.GraphViewId"
