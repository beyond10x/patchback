      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.audio.AudioClipId"
    },
    "patchback.audio.RenderId": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "RenderId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.audio.RenderId"
    },
    "patchback.fit.FitRunId": {
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "FitRunId",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.fit.FitRunId"
    },
    "patchback.fit.LossComponents": {
      "additionalProperties": false,
      "description": "The four component values of the comparison loss of DESIGN.md 9.1; the loss code logs them for every candidate.",
      "properties": {
        "band_energy": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "envelope": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "log_spectral": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "transient": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "log_spectral",
        "envelope",
        "transient",
        "band_energy"
      ],
      "title": "LossComponents",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "patchback.fit.LossComponents"
    },
    "patchback.patch.ClampPolicy": {
      "description": "What happens to a normalized value outside [0,1] (section 5.2 clamps p to [0,1]).",
      "enum": [
        "ClampToUnitInterval"
      ],
      "title": "ClampPolicy",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.ClampPolicy"
    },
    "patchback.patch.ModuleFamily": {
      "description": "A family of module kinds a topology admits beyond the fixed subtractive voice.",
      "enum": [
        "SquareSine",
        "HighpassBandpass",
        "Lfo",
        "Delay",
        "Noise"
      ],
      "title": "ModuleFamily",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.ModuleFamily"
    },
    "patchback.patch.NodeKind": {
      "enum": [
        "NoteInput",
        "SawOscillator",
        "Drive",
        "LowpassFilter",
        "AdsrEnvelope",
        "Vca",
        "Output",
        "SquareOscillator",
        "SineOscillator",
        "HighpassFilter",
        "BandpassFilter",
        "Lfo",
        "Delay",
        "Noise"
      ],
      "title": "NodeKind",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.NodeKind"
    },
    "patchback.patch.ParameterContract": {
      "additionalProperties": false,
      "description": "Domain, default, unit, mapping and clamping policy of one parameter (section 2, invariant 2).",
      "properties": {
        "clamp": {
          "$ref": "#/$defs/patchback.patch.ClampPolicy"
        },
        "default_normalized": {
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "index": {
          "description": "Position of the parameter in the model's normalized target vector.",
          "type": "integer"
        },
        "mapping": {
          "$ref": "#/$defs/patchback.patch.ParameterMapping"
        },
        "path": {
          "$ref": "#/$defs/patchback.patch.ParameterPath"
        },
        "physical_at_one": {
          "description": "Physical value at p = 1, the upper end of the domain.",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "physical_at_zero": {
          "description": "Physical value at p = 0, the lower end of the domain.",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/patchback.patch.ParameterUnit"
        }
      },
      "required": [
        "path",
        "index",
        "unit",
        "mapping",
        "physical_at_zero",
        "physical_at_one",
        "default_normalized",
        "clamp"
      ],
      "title": "ParameterContract",
      "type": "object",
      "x-ess-kind": "struct",
      "x-ess-name": "patchback.patch.ParameterContract"
    },
    "patchback.patch.ParameterMapping": {
      "description": "How a normalized value p in [0,1] maps to the physical value: Exponential is at_zero * (at_one / at_zero)^p, Linear is at_zero + (at_one - at_zero) * p.",
      "enum": [
        "Exponential",
        "Linear"
      ],
      "title": "ParameterMapping",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.ParameterMapping"
    },
    "patchback.patch.ParameterPath": {
      "description": "The stable identifier of one parameter of a topology.",
      "title": "ParameterPath",
      "type": "string",
      "x-ess-kind": "newtype",
      "x-ess-name": "patchback.patch.ParameterPath"
    },
    "patchback.patch.ParameterUnit": {
      "enum": [
        "Seconds",
        "LinearAmplitude",
        "Hertz",
        "Dimensionless",
        "Decibels"
      ],
      "title": "ParameterUnit",
      "type": "string",
      "x-ess-kind": "enum",
      "x-ess-name": "patchback.patch.ParameterUnit"
    },
